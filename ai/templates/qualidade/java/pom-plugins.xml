<!--
  Trechos para o pom.xml do módulo Java. Copie para <dependencies> e <build><plugins>.
  Versões de referência: confirme as mais recentes estáveis ao copiar.
  O mínimo de cobertura (0.80) deve ser igual ao "Cobertura mínima de testes" do AGENTS.md.
-->

<!-- <dependencies> -->
<dependency>
  <groupId>com.tngtech.archunit</groupId>
  <artifactId>archunit-junit5</artifactId>
  <version>1.3.0</version>
  <scope>test</scope>
</dependency>

<!-- <build><plugins> -->
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-checkstyle-plugin</artifactId>
  <version>3.6.0</version>
  <dependencies>
    <dependency>
      <groupId>com.puppycrawl.tools</groupId>
      <artifactId>checkstyle</artifactId>
      <version>10.21.0</version>
    </dependency>
  </dependencies>
  <configuration>
    <configLocation>${project.basedir}/config/checkstyle.xml</configLocation>
    <includeTestSourceDirectory>true</includeTestSourceDirectory>
    <consoleOutput>true</consoleOutput>
    <failOnViolation>true</failOnViolation>
    <violationSeverity>error</violationSeverity>
    <!-- Classe gerada: exclua aqui e explique o motivo.
    <excludes>**/generated/**</excludes> -->
  </configuration>
  <executions>
    <execution>
      <id>estilo-obrigatorio</id>
      <phase>verify</phase>
      <goals><goal>check</goal></goals>
    </execution>
  </executions>
</plugin>

<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-pmd-plugin</artifactId>
  <version>3.26.0</version>
  <configuration>
    <rulesets><ruleset>${project.basedir}/config/pmd-ruleset.xml</ruleset></rulesets>
    <includeTests>true</includeTests>
    <printFailingErrors>true</printFailingErrors>
    <!-- Duplicação (Q-12) é recomendada: apenas alerta. -->
    <minimumTokens>100</minimumTokens>
    <failOnViolation>true</failOnViolation>
  </configuration>
  <executions>
    <execution>
      <id>codigo-morto-obrigatorio</id>
      <phase>verify</phase>
      <goals><goal>check</goal></goals>
    </execution>
    <execution>
      <id>duplicacao-alerta</id>
      <phase>verify</phase>
      <goals><goal>cpd-check</goal></goals>
      <configuration>
        <failOnViolation>false</failOnViolation>
      </configuration>
    </execution>
  </executions>
</plugin>

<plugin>
  <groupId>org.jacoco</groupId>
  <artifactId>jacoco-maven-plugin</artifactId>
  <version>0.8.12</version>
  <executions>
    <execution>
      <id>preparar-agente</id>
      <goals><goal>prepare-agent</goal></goals>
    </execution>
    <execution>
      <id>relatorio</id>
      <phase>verify</phase>
      <goals><goal>report</goal></goals>
    </execution>
    <execution>
      <id>minimo-de-cobertura</id>
      <phase>verify</phase>
      <goals><goal>check</goal></goals>
      <configuration>
        <rules>
          <rule>
            <element>BUNDLE</element>
            <limits>
              <limit>
                <counter>LINE</counter>
                <value>COVEREDRATIO</value>
                <minimum>0.80</minimum>
              </limit>
            </limits>
          </rule>
        </rules>
      </configuration>
    </execution>
  </executions>
</plugin>
